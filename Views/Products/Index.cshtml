@model IEnumerable<day6_17.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
    int currentPage = ViewData["CurrentPage"] != null ? (int)ViewData["CurrentPage"] : 1;
    int totalPages = ViewData["TotalPages"] != null ? (int)ViewData["TotalPages"] : 1;
    var currentFilter = ViewData["CurrentFilter"];
}

<div class="container mt-4">
    <h2>Danh sách sản phẩm</h2>
    <form asp-action="Index" method="get" class="mb-3">
        <div style="display: flex; align-items: center;">
            <input type="text" name="searchString" value="@currentFilter" style="width: 300px;" class="form-control me-2" placeholder="Nhập tên sản phẩm cần tìm..." />     
            <button type="submit" class="btn btn-primary me-2">Search</button>
            <a asp-action="Index" class="text-decoration-none">Quay lại danh sách</a>
        </div>
    </form>
    <p>
        <a asp-action="Create" style="background-color: red; class="btn btn-success">+ Create New</a>
    </p>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tên sản phẩm</th>
                <th>Giá</th>
                <th>Số lượng</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@item.Price.ToString("N0") VNĐ</td>
                        <td>@item.Quantity</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                            <a asp-action="Delete" asp-route-id="@item.Id" onclick="return confirm('Bạn có chắc muốn xóa?');">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">Không có dữ liệu phù hợp.</td>
                </tr>
            }
            <tr>
                <td colspan="2">
                    <form asp-action="Index" method="get" style="display: inline;">
                        <input type="hidden" name="searchString" value="@currentFilter" />
                        <input type="submit" value="Go to" class="btn btn-sm btn-outline-secondary" /> page 
                        <input type="number" max="@totalPages" min="1" name="page" value="@currentPage" style="width: 60px; display: inline-block;" class="form-control form-control-sm d-inline-block" /> of @totalPages
                    </form>
                </td>
                <td colspan="3" class="text-end">
                    <strong>Tổng số sản phẩm trang này: @(Model?.Count() ?? 0)</strong>
                </td>
            </tr>
        </tbody>
    </table>
</div>